# Copy this file to .env in your own project folder - not into this
# documentation clone - and fill in your details.
# Never commit real credentials.
#
# Set these yourself. Do not paste credentials into an AI agent chat window;
# the agent only needs to reference these names, never their values.

LITHOSURFER_USER=

# Optional. Leave blank or delete the line to be prompted at each run.
LITHOSURFER_PASSWORD=

# Optional. Defaults to https://app.ausgeochem.org
LITHOSURFER_HOST=https://app.ausgeochem.org
